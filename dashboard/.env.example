# Copy this file to .env.local and fill in your own development values.
# Never commit .env.local. Never paste these values into a chat or a document.

# Supabase (your development project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Who may sign in (comma list). Server only. With nothing here, nobody can get in.
DASHBOARD_OWNER_EMAILS=

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=

# Long random value that protects the scheduled-job addresses
JOBS_SECRET=

# Shows the builder-only Systems page while developing (until sign-in decides who is the builder).
# Off by default. Set it to on in your own .env.local only. Never set it on a client's live site.
BUILDER_PAGES=

# The dashboard's own address
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayMongo (only if the Money system takes online payments). Server only, never in the browser.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Publishing: the website project's Deploy Hook address (Vercel: Settings, Git, Deploy Hooks). Private, like a key.
WEBSITE_DEPLOY_HOOK=
# On the website project (not here) set CONTENT_URL to this dashboard's address, so publishing takes the saved words.

# Sending through the studio's own Gmail (reaches anyone, no domain needed). The app password is made in the Google account
# (Security, 2-Step Verification, App passwords). Private, like any key.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# A long random word of your own: Vercel sends it with the daily reminder run.
CRON_SECRET=
